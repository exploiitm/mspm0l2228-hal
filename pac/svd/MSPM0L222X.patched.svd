              </field>
              <field>
                <name>TTXFIFOTRG</name>
                <description>Target Transmit FIFO Trigger</description>
                <bitOffset>3</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NO_EFFECT</name>
                    <description>Clear Interrupt Mask</description>
