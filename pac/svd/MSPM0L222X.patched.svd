                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMACH4</name>
                <description>DMA Channel 4 interrupt signals that size counter reached zero (DMASZ=0).</description>
                <bitOffset>4</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NO_EFFECT</name>
                    <description>Writing 0 has no effect</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear interrupt</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMACH5</name>
                <description>DMA Channel 5 interrupt signals that size counter reached zero (DMASZ=0).</description>
                <bitOffset>5</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NO_EFFECT</name>
                    <description>Writing 0 has no effect</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear interrupt</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMACH6</name>
                <description>DMA Channel 6 interrupt signals that size counter reached zero (DMASZ=0).</description>
                <bitOffset>6</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NO_EFFECT</name>
                    <description>Writing 0 has no effect</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear interrupt</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PREIRQCH0</name>
                <description>Pre-IRQ for Channel 0. Size counter reached Pre-IRQ threshold.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear interrupt mask bit</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SET</name>
                    <description>Set interrupt mask bit</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PREIRQCH1</name>
                <description>Pre-IRQ for Channel 1. Size counter reached Pre-IRQ threshold.</description>
                <bitOffset>17</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear interrupt mask bit</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SET</name>
                    <description>Set interrupt mask bit</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PREIRQCH2</name>
                <description>Pre-IRQ for Channel 2. Size counter reached Pre-IRQ threshold.</description>
                <bitOffset>18</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear interrupt mask bit</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SET</name>
                    <description>Set interrupt mask bit</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>ADDRERR</name>
                <description>DMA address error, SRC address not reachable.</description>
                <bitOffset>24</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear interrupt mask bit</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SET</name>
                    <description>Set interrupt mask bit</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DATAERR</name>
                <description>DMA data error, SRC data might be corrupted (PAR or ECC error).</description>
                <bitOffset>25</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear interrupt mask bit</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SET</name>
                    <description>Set interrupt mask bit</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <register>
          <name>DMA_EVT_MODE</name>
          <description>Event Mode</description>
          <addressOffset>0x10E0</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>INT0_CFG</name>
              <description>Event line mode select for event corresponding to interrupt event CPU_INT</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>The interrupt or event line is disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SOFTWARE</name>
                  <description>The interrupt or event line is in software mode. Software must clear the RIS.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HARDWARE</name>
                  <description>The interrupt or event line is in hardware mode. The hardware (another module) clears automatically the associated RIS flag.</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EVT1_CFG</name>
              <description>Event line mode select for event corresponding to generic event  GEN_EVENT</description>
              <bitOffset>2</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>The interrupt or event line is disabled.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SOFTWARE</name>
                  <description>The interrupt or event line is in software mode. Software must clear the RIS.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HARDWARE</name>
                  <description>The interrupt or event line is in hardware mode. The hardware (another module) clears automatically the associated RIS flag.</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_DESC</name>
          <description>Module Description</description>
          <addressOffset>0x10FC</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>MINREV</name>
              <description>Minor rev of the IP</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>MAJREV</name>
              <description>Major rev of the IP</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>FEATUREVER</name>
              <description>Feature Set for the DMA: number of DMA channel minus one  (e.g. 0-&gt;1ch, 2-&gt;3ch, 15-&gt;16ch).</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>MODULEID</name>
              <description>Module identification contains a unique peripheral identification number. The assignments are maintained in a central database for all of the platform modules to ensure uniqueness.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA_DMAPRIO</name>
          <description>DMA Channel Priority Control</description>
          <addressOffset>0x1100</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <fields>
            <field>
              <name>ROUNDROBIN</name>
              <description>Round robin. This bit enables the round-robin DMA channel priorities.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Roundrobin priority disabled, DMA channel priority is fixed: DMA0-DMA1-DMA2-...-DMA16</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Roundrobin priority enabled, DMA channel priority changes with each transfer</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BURSTSZ</name>
              <description>Define the burst size of a block transfer, before the priority is re-evaluated</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INFINITI</name>
                  <description>There is no burst size, the whole block transfer is completed on one transfer without interruption</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BURST_8</name>
                  <description>The burst size is 8, after 8 transfers the block transfer is interrupted and the priority is reevaluated</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSRT_16</name>
                  <description>The burst size is 16, after 16 transfers the block transfer is interrupted and the priority is reevaluated</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BURST_32</name>
                  <description>The burst size is 32, after 32 transfers the block transfer is interrupted and the priority is reevaluated</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <cluster>
          <dim>7</dim>
          <dimIncrement>0x4</dimIncrement>
          <dimArrayIndex/>
          <name>DMA_DMATRIG[%s]</name>
          <addressOffset>0x1110</addressOffset>
          <register>
            <name>DMA_DMATCTL</name>
            <description>DMA Trigger Select</description>
            <addressOffset>0x0</addressOffset>
            <size>0x20</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>DMATSEL</name>
                <description>DMA Trigger Select 

Note: Reference the datasheet of the device to see the specific trigger mapping.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>6</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DMAREQ</name>
                    <description>Software trigger request</description>
                    <value>0</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMATINT</name>
                <description>DMA Trigger by Internal Channel</description>
                <bitOffset>7</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>EXTERNAL</name>
                    <description>DMATSEL will define external trigger select as transfer trigger.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INTERNAL</name>
                    <description>DMATSEL will define internal channel as transfer trigger select. 0-&gt; Channel0-done, 1-&gt; Channel1-done, ...</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <cluster>
          <dim>7</dim>
          <dimIncrement>0x10</dimIncrement>
          <dimArrayIndex/>
          <name>DMA_DMACHAN[%s]</name>
          <addressOffset>0x1200</addressOffset>
          <register>
            <name>DMA_DMACTL</name>
            <description>DMA Channel Control</description>
            <addressOffset>0x0</addressOffset>
            <size>0x20</size>
            <access>read-write</access>
            <fields>
              <field>
                <name>DMAREQ</name>
                <description>DMA request. Software-controlled DMA start. DMAREQ is reset automatically.</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>IDLE</name>
                    <description>Default read value</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>REQUEST</name>
                    <description>DMA transfer request (start DMA)</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMAEN</name>
                <description>DMA enable</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>DMA channel disabled</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLE</name>
                    <description>DMA channel enabled</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMASRCWDTH</name>
                <description>DMA source width. This bit selects the source data width as a byte, half word, word or long word.</description>
                <bitOffset>8</bitOffset>
                <bitWidth>2</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BYTE</name>
                    <description>Source data width is BYTE (8-bit)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HALF</name>
                    <description>Source data width is HALF-WORD (16-bit)</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WORD</name>
                    <description>Source data width is WORD (32-bit)</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LONG</name>
                    <description>Source data width is LONG-WORD (64-bit)</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMADSTWDTH</name>
                <description>DMA destination width. This bit selects the destination as a byte, half word, word or long word.</description>
                <bitOffset>12</bitOffset>
                <bitWidth>2</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BYTE</name>
                    <description>Destination data width is BYTE (8-bit)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HALF</name>
                    <description>Destination data width is HALF-WORD (16-bit)</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WORD</name>
                    <description>Destination data width is WORD (32-bit)</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LONG</name>
                    <description>Destination data width is LONG-WORD (64-bit)</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMASRCINCR</name>
                <description>DMA source increment. This bit selects automatic incrementing or decrementing of the source address DMASA for each transfer. The amount of change to the DMASA is based on the definitin in the DMASRCWDTH. For example an increment of 1 (+1) on a WORD transfer will increment the DMASA by 4.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>4</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNCHANGED</name>
                    <description>Address is unchanged (+0)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DECREMENT</name>
                    <description>Decremented by 1 (-1 * DMASRCWDTH)</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INCREMENT</name>
                    <description>Incremented by 1 (+1 * DMASRCWDTH)</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_2</name>
                    <description>Stride size 2 (+2 * DMASRCWDTH)</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_3</name>
                    <description>Stride size 3 (+3 * DMASRCWDTH)</description>
                    <value>9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_4</name>
                    <description>Stride size 4 (+4 * DMASRCWDTH)</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_5</name>
                    <description>Stride size 5 (+5 * DMASRCWDTH)</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_6</name>
                    <description>Stride size 6 (+6 * DMASRCWDTH)</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_7</name>
                    <description>Stride size 7 (+7 * DMASRCWDTH)</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_8</name>
                    <description>Stride size 8 (+8 * DMASRCWDTH)</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_9</name>
                    <description>Stride size 9 (+9 * DMASRCWDTH)</description>
                    <value>15</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMADSTINCR</name>
                <description>DMA destination increment. This bit selects automatic incrementing or decrementing of the destination address DMADA for each transfer. The amount of change to the DMADA is based on the definitin in the DMADSTWDTH. For example an increment of 1 (+1) on a WORD transfer will increment the DMADA by 4.</description>
                <bitOffset>20</bitOffset>
                <bitWidth>4</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNCHANGED</name>
                    <description>Address is unchanged (+0)</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DECREMENT</name>
                    <description>Decremented by 1 (-1 * DMADSTWDTH)</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INCREMENT</name>
                    <description>Incremented by 1 (+1 * DMADSTWDTH)</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_2</name>
                    <description>Stride size 2 (+2 * DMADSTWDTH)</description>
                    <value>8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_3</name>
                    <description>Stride size 3 (+3 * DMADSTWDTH)</description>
                    <value>9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_4</name>
                    <description>Stride size 4 (+4 * DMADSTWDTH)</description>
                    <value>10</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_5</name>
                    <description>Stride size 5 (+5 * DMADSTWDTH)</description>
                    <value>11</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_6</name>
                    <description>Stride size 6 (+6 * DMADSTWDTH)</description>
                    <value>12</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_7</name>
                    <description>Stride size 7 (+7 * DMADSTWDTH)</description>
                    <value>13</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_8</name>
                    <description>Stride size 8 (+8 * DMADSTWDTH)</description>
                    <value>14</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_9</name>
                    <description>Stride size 9 (+9 * DMADSTWDTH)</description>
                    <value>15</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMATM</name>
                <description>DMA transfer mode register

Note: The repeat-single (2h) and repeat-block (3h) transfer are only available in a FULL-channel configuration. Please consult the datasheet of the specific device to map which channel number has FULL or BASIC capability. In a BASIC channel configuration only the values for single (0h) and block (1h) transfer can be set.</description>
                <bitOffset>28</bitOffset>
                <bitWidth>2</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>SINGLE</name>
                    <description>Single transfer. Each transfers requires a new trigger. When the DMASZ counts down to zero an event can be generated and the DMAEN is cleared.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BLOCK</name>
                    <description>Block transfer. Each trigger transfers the complete block defined in DMASZ. After the transfer is complete an event can be generated and the DMAEN is cleared.</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RPTSNGL</name>
                    <description>Repeated single transfer. Each transfers requires a new trigger. When the DMASZ counts down to zero an event can be generated. After the last transfer the DMASA, DMADA, DAMSZ registers are restored to its initial value and the DMAEN stays enabled.</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RPTBLCK</name>
                    <description>Repeated block transfer. Each trigger transfers the complete block defined in DMASZ. After the last transfer the DMASA, DMADA, DAMSZ registers are restored to its initial value and the DMAEN stays enabled.</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMAEM</name>
                <description>DMA extended mode

Note: The extended transfer modes are only available in a FULL-channel configuration. Please consult the datasheet of the specific device to map which channel number has FULL or BASIC capability. In a BASIC channel configuration this register is a read-only register and reads 0x0.</description>
                <bitOffset>24</bitOffset>
                <bitWidth>2</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NORMAL</name>
                    <description>Normal mode is related to transfers from SRC to DST</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FILLMODE</name>
                    <description>Fill mode will copy the SA register content as data to DA</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TABLEMODE</name>
                    <description>Table mode will read an address and data value from SA and write the data to address</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMAPREIRQ</name>
                <description>Enable an early IRQ event. This can help software to react quicker to and DMA done event or allows some additional configuration before the channel is complete. 

Note: This register is only available in a FULL-channel configuration. Please consult the datasheet of the specific device to map which channel number has FULL or BASIC capability. In a BASIC configuration this register is a read only value and always reads as 0x0.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>3</bitWidth>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PREIRQ_DISABLE</name>
                    <description>Pre-IRQ event disabled.</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_1</name>
                    <description>Issure Pre-IRQ event when DMASZ=1</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_2</name>
                    <description>Issure Pre-IRQ event when DMASZ=2</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_4</name>
                    <description>Issure Pre-IRQ event when DMASZ=4</description>
                    <value>3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_8</name>
                    <description>Issure Pre-IRQ event when DMASZ=8</description>
                    <value>4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_32</name>
                    <description>Issure Pre-IRQ event when DMASZ=32</description>
                    <value>5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_64</name>
                    <description>Issure Pre-IRQ event when DMASZ=64</description>
                    <value>6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_HALF</name>
