                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FLASHDED</name>
              <description>Flash Double Error Detect</description>
