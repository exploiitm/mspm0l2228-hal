                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TXIFG</name>
                    <description>UART transmit interrupt; Interrupt Flag: TX</description>
                    <value>12</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
