        <register>
          <name>USERID</name>
          <description>User ID</description>
          <addressOffset>0x8</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>PART</name>
              <description>Bit pattern that uniquely identifying a part</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
            </field>
            <field>
              <name>VARIANT</name>
              <description>Bit pattern uniquely identifying the variant for the part</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>MINORREV</name>
              <description>Monotonic increasing value indicating a new revision of the SKU that preserves compatability with lesser minor rev values. New capability may be introduced such that lesser minor rev numbers may not be compatible with greater if the new capability is used.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>MAJORREV</name>
              <description>Monotonic increasing value indiciating a new revision of the SKU significant enough that users of the device may have tro revise PCB or software design</description>
              <bitOffset>28</bitOffset>
              <bitWidth>3</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMFLASH</name>
          <description>SRAM flash</description>
          <addressOffset>0x18</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <fields>
            <field>
              <name>MAINFLASH_SZ</name>
              <description>The encoding of the field is that value of the field is an interger to be interpreted as number of KB.
For example, if the value of the field id 4, then it is 4KB, the value is 32KB, and so on.
</description>
              <bitOffset>0</bitOffset>
              <bitWidth>11</bitWidth>
            </field>
            <field>
              <name>MAINNUMBANKS</name>
              <bitOffset>12</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
            <field>
              <name>SRAM_SZ</name>
              <description>The encoding of the field is that the value of the field is an integer to be interpreted as number of KB.
For example id 4, then it is 4KB, if the value is 32, then 32KB, and so on.
</description>
              <bitOffset>16</bitOffset>
              <bitWidth>10</bitWidth>
            </field>
            <field>
              <name>DATAFLASH_SZ</name>
              <description>The encoding of the field is that the value of the field is an integer to be interpreted as number of KB.
For example id 4, then it is 4KB, if the value is 32, then 32KB, and so on.
</description>
              <bitOffset>26</bitOffset>
              <bitWidth>6</bitWidth>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>KEYSTORECTL</name>
      <version>1.0</version>
      <description>PERIPHERALREGION</description>
      <groupName>KEYSTORECTL</groupName>
      <baseAddress>0x400AC000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>KEYSTORECTL_CFG</name>
          <description>Keystore configuration</description>
          <addressOffset>0x1100</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <fields>
            <field>
              <name>NK256</name>
              <description>Number of 256 bit keys to be held in the key-store.
Can not exceed the total number of slots present in the hardware / 2.
For eg: if SYS_N_SLOTS = 4, then atmost 2 256-bit keys can be held in the key-store.
Incorrect setting of this field will be reported via STATUS register</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ZERO</name>
                  <description>No 256-bit keys</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ONE</name>
                  <description>One 256-bit key</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TWO</name>
                  <description>Two 256-bit keys</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THREE</name>
                  <description>Three 256-bit keys</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FOUR</name>
                  <description>Four 256-bit keys</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>KEYSTORECTL_KEYWR</name>
          <description>Key write configuration</description>
          <addressOffset>0x1104</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>KEYSZSEL</name>
              <description>Key size selection. Selection of 128 or 256 bit keys</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>K256</name>
                  <description>256 bit key</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>K128</name>
                  <description>128 bit key</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEYSLOTSEL</name>
              <description>Select the key slot to write the key into.
NOTE: SW needs to ensure that it is writing to the correct slots. The slot numbering is from 0 through SYS_N_SLOTS-1.
Each slot is a 128-bit slot. Therefore, when writing a 256-bit key, two slots will need to budgeted.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SLOT0</name>
                  <description>Slot 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT1</name>
                  <description>Slot 1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT2</name>
                  <description>Slot 2</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT3</name>
                  <description>Slot 3</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT4</name>
                  <description>Slot 4</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT5</name>
                  <description>Slot 5</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT6</name>
                  <description>Slot 6</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLOT7</name>
                  <description>Slot 7</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>KEYSTORECTL_KEYRD</name>
          <description>Key read configuration</description>
          <addressOffset>0x1108</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>KEYSZSEL</name>
              <description>Key size selection. Selection of 128 or 256 bit keys</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>K256</name>
                  <description>256 bit key</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>K128</name>
                  <description>128 bit key</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEYSLOTSEL</name>
              <description>Select the key slot to read the key from.
NOTE: SW needs to ensure that it is reading from the correct slots. The slot numbering is from 0 through SYS_N_SLOTS-1.
Each slot is a 128-bit slot. Therefore, when reading a 256-bit key, two adjacent slots will be read.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>4</bitWidth>
            </field>
            <field>
              <name>CRYPTOSEL</name>
              <description>Crypto engine selector</description>
              <bitOffset>8</bitOffset>
              <bitWidth>2</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>AES</name>
                  <description>Transfer key to AES</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>KEYSTORECTL_STATUS</name>
          <description>Status</description>
          <addressOffset>0x110C</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00020001</resetValue>
          <fields>
            <field>
              <name>STAT</name>
              <description>Status information</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <enumeratedValues>
                <enumeratedValue>
                  <name>VALID</name>
                  <description>Valid configuration</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NO_CFG</name>
                  <description>Key-store has not been configured. NK256 has not been set.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INVALID_NK256</name>
                  <description>Invalid value for NK256 field in CFG.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSY_RECEIVE</name>
                  <description>Busy receiving a key deposit</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSY_TRANSMIT</name>
                  <description>Busy transmitting a key to a crypto engine</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INVALID_KEYSLOTSELW</name>
                  <description>Invalid keyslot selection for writing</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>INVALID_KEYSLOTSELR</name>
                  <description>Invalid keyslot selection for reading</description>
                  <value>6</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VALID</name>
              <description>Bitvector of valid bits to indicate which slots have been configured</description>
              <bitOffset>4</bitOffset>
              <bitWidth>8</bitWidth>
            </field>
            <field>
              <name>NKEYSLOTS</name>
              <description>Size of keystorage: Number of 128-bit key slots</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TWO</name>
                  <description>Two slots</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>THREE</name>
                  <description>Three slots</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FOUR</name>
                  <description>Four slots</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>KEYSTORECTL_KEYIN</name>
          <description>Input key</description>
          <addressOffset>0x1110</addressOffset>
          <size>0x20</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TRNG</name>
      <version>1.0</version>
      <description>PERIPHERALREGION</description>
      <groupName>TRNG</groupName>
      <baseAddress>0x40444000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1E00</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>INT_GROUP1</name>
        <description>TRNG interrupt (group 1, IIDX 5)</description>
        <value>1</value>
      </interrupt>
      <registers>
        <cluster>
          <dim>1</dim>
          <dimIncrement>0x18</dimIncrement>
          <dimArrayIndex/>
          <name>TRNG_GPRCM[%s]</name>
          <addressOffset>0x800</addressOffset>
          <register>
            <name>TRNG_PWREN</name>
            <description>Power enable</description>
            <addressOffset>0x0</addressOffset>
            <size>0x20</size>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>ENABLE</name>
                <description>Enable the power</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>Disable Power</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ENABLE</name>
                    <description>Enable Power</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>KEY_UNLOCK</name>
                <description>Key unlock for TRNG power enable</description>
                <bitOffset>24</bitOffset>
                <bitWidth>8</bitWidth>
                <enumeratedValues>
                  <name>KEY_UNLOCK</name>
                  <enumeratedValue>
                    <name>LOCK</name>
                    <description>Lock pwren</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UNLOCK</name>
                    <description>Unlock pwren</description>
                    <value>38</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>TRNG_RSTCTL</name>
            <description>Reset Control</description>
            <addressOffset>0x4</addressOffset>
            <size>0x20</size>
            <access>write-only</access>
            <resetValue>0x00000000</resetValue>
            <fields>
              <field>
                <name>RESETSTKYCLR</name>
                <description>Clear the RESETSTKY bit in the STAT register</description>
                <bitOffset>1</bitOffset>
                <bitWidth>1</bitWidth>
                <access>write-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NOP</name>
                    <description>Writing 0 has no effect</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CLR</name>
                    <description>Clear reset sticky bit</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>RESETASSERT</name>
                <description>Assert reset to the peripheral</description>
                <bitOffset>0</bitOffset>
                <bitWidth>1</bitWidth>
                <access>write-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NOP</name>
                    <description>Writing 0 has no effect</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>ASSERT</name>
                    <description>Assert reset</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>KEY_UNLOCK</name>
                <description>Key unlock for TRNG reset control</description>
                <bitOffset>24</bitOffset>
                <bitWidth>8</bitWidth>
                <enumeratedValues>
                  <name>KEY_UNLOCKW</name>
                  <enumeratedValue>
                    <name>LOCK</name>
                    <description>Lock reset</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>UNLOCK</name>
                    <description>Unlock reset</description>
                    <value>177</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>TRNG_GPRCM_STAT</name>
            <description>Status Register</description>
            <addressOffset>0x14</addressOffset>
            <size>0x20</size>
            <access>read-only</access>
            <fields>
              <field>
                <name>RESETSTKY</name>
                <description>This bit indicates, if the peripheral was reset, since this bit was cleared by RESETSTKYCLR in the RSTCTL register</description>
                <bitOffset>16</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NORES</name>
                    <description>The peripheral has not been reset since this bit was last cleared by RESETSTKYCLR in the RSTCTL register</description>
                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RESET</name>
                    <description>The peripheral was reset since the last bit clear</description>
                    <value>1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
        <register>
          <name>TRNG_IIDX</name>
          <description>Interrupt index</description>
          <addressOffset>0x1020</addressOffset>
          <size>0x20</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          <fields>
            <field>
              <name>STAT</name>
              <description>Interrupt index status</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_INTR</name>
                  <description>No bit is set means there is no pending interrupt request</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IRQ_HEALTH_FAIL</name>
                  <description>Indicates that a health test has failed. The TRNG is in an error state until the interrupt is cleared.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IRQ_CMD_FAIL</name>
                  <description>Indicates that the just issued command was rejected and is not being performed.</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IRQ_CMD_DONE</name>
                  <description>Indicates that the current command/mode is done. This may have different meanings based on the mode: OFF --&gt; Power has been turned off PWRUP_DIG --&gt; Digital powerup tests are done PWRUP_ANA --&gt; Analog powerup tests are done NORM_FUNC --&gt; No IRQ, since mode runs indefinitely until a new command is issued</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IRQ_CAPTURED_RDY</name>
                  <description>Indicates that the captured word buffer is ready to be copied to memory</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>TRNG_IMASK</name>
          <description>Interrupt mask</description>
          <addressOffset>0x1028</addressOffset>
          <size>0x20</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>
          <fields>
            <field>
              <name>IRQ_HEALTH_FAIL</name>
              <description>Mask for IRQ_HEALTH_FAIL. Indicates that a health test has failed.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Interrupt is masked out</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLED</name>
                  <description>Interrupt will request an interrupt service routine and corresponding bit in MIS will be set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IRQ_CAPTURED_RDY</name>
              <description>Mask for IRQ_CAPTURED_RDY. Indicates to the CPU that the Captured Word is ready to be read.</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Interrupt is masked out</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLED</name>
                  <description>Interrupt will request an interrupt service routine and corresponding bit in MIS will be set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
