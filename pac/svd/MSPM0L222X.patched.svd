            </field>
            <field>
              <name>VBATUP</name>
              <description>VBAT Power On</description>
              <bitOffset>6</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
