                <enumeratedValue>
                  <name>ENABLED</name>
                  <description>Interrupt will request an interrupt service routine and corresponding bit in MIS will be set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
