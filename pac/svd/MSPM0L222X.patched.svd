          <fields>
            <field>
              <name>COMMAND</name>
              <description>Command type</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOOP</name>
                  <description>No Operation</description>
                  <value>0</value>
