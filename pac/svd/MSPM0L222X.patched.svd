              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CPU</name>
                  <description>Issue a SYSRST (CPU plus peripherals only)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOT</name>
                  <description>Issue a BOOTRST (CPU, peripherals, and boot configuration routine)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTLOADERENTRY</name>
                  <description>Issue a SYSRST and enter the boot strap loader (BSL)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POR</name>
                  <description>Issue a power-on reset (POR)</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTLOADEREXIT</name>
                  <description>Issue a SYSRST and exit the boot strap loader (BSL)</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
